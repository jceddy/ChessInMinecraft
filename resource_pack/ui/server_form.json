/*
 * EXPERIMENTAL, unverified in-game. See README.md "Visual grid board" section.
 *
 * Overrides part of vanilla's ui/server_form.json (the screen that renders
 * every ActionFormData shown by any behavior pack) so that a long_form with
 * *exactly* 64 buttons - which is what the chess board sends, one button
 * per square - renders as an 8x8 grid instead of vanilla's vertical list.
 * A long_form with any other button count (join screen, other add-ons'
 * menus, etc.) is untouched and still renders as the normal vertical list.
 *
 * This works by redefining server_form.long_form_scrolling_content (copied
 * from the vanilla file almost verbatim - see
 * https://github.com/Mojang/bedrock-samples/blob/main/resource_pack/ui/server_form.json)
 * to route through a new chess_dynamic_buttons_router control instead of
 * vanilla's long_form_dynamic_buttons_panel directly. The router shows
 * either the original vanilla button list (buttons_list, an instance of
 * the unmodified vanilla control) or a new 8x8 grid (buttons_grid),
 * toggled by a "#collection_length = 64" view binding - the same
 * binding/molang mechanism vanilla itself uses for conditional visibility
 * elsewhere in this file (see dynamic_button's image visibility binding).
 *
 * Unverified assumptions - check these in-game before relying on this:
 *   - that a `type: "grid"` control accepts `collection_name` and exposes
 *     `#form_button_contents` the same way `stack_panel` does
 *   - that `grid_dimensions: [8, 8]` fills row-major, left-to-right then
 *     top-to-bottom (so it matches DISPLAY_ORDER in chess/ui.js: rank 8
 *     first, files a-h)
 *   - that the 225x200 long_form dialog frame is content-driven enough to
 *     fit a 192x192 grid without clipping (cell size may need tuning)
 *   - that button_text still routes through `response.selection` correctly
 *     when instantiated via `grid_item_template` instead of a `factory`
 *
 * If any of this doesn't hold up in-game, delete this file and remove its
 * entry from ui/_ui_defs.json - the board falls back to the original
 * vertical-list rendering with no other code changes needed.
 */
{
  "namespace": "server_form",

  "long_form_scrolling_content": {
    "type": "stack_panel",
    "size": [ "100% - 4px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",

    "controls": [
      {
        "label_offset_panel": {
          "type": "panel",
          "size": ["100%", "100%c"],
          "controls": [
            {
              "main_label": {
                "type": "label",
                "offset": [2,2],
                "color": "$main_header_text_color",
                "size": ["100%", "default"],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "text": "#form_text"
              }
            }
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      },
      {
        "wrapping_panel": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "chess_dynamic_buttons_router@server_form.chess_dynamic_buttons_router": {}
            }
          ]
        }
      }
    ]
  },

  "chess_dynamic_buttons_router": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      {
        "buttons_list@server_form.long_form_dynamic_buttons_panel": {
          "bindings": [
            {
              "binding_name": "#form_button_contents",
              "binding_name_override": "#collection_length"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#collection_length = 64))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "buttons_grid@server_form.chess_grid_panel": {}
      }
    ]
  },

  "chess_grid_panel": {
    "type": "grid",
    "size": [ 192, 192 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "grid_dimensions": [ 8, 8 ],
    "grid_item_template": "server_form.chess_grid_button",
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#collection_length = 64)",
        "target_property_name": "#visible"
      }
    ]
  },

  "chess_grid_button@common_buttons.light_text_button": {
    "$pressed_button_name": "button.form_button_click",
    "size": [ 24, 24 ],
    "$button_text": "#form_button_text",
    "$button_text_binding_type": "collection",
    "$button_text_grid_collection_name": "form_buttons",
    "$button_text_max_size": [ "100%", "100%" ],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ]
  }
}
